FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 350;

boundaryField
{
    liner
    {
        type            fixedValue;
        value           uniform 443;
    }

    fins
    {
        type            mixed;
        refValue        uniform 300;
        refGradient     uniform 0;
        valueFraction   uniform 0.04;
        value           uniform 330;
    }

    topDeck
    {
        type            zeroGradient;
    }

    baseFlange
    {
        type            zeroGradient;
    }
}


